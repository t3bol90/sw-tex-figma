{
  "name": "math-text-figma-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "A Figma plugin foundation for mixed Markdown and LaTeX text.",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm run build --watch",
    "build": "pnpm run build:ui && pnpm run build:code",
    "build:ui": "vite build --mode ui",
    "build:code": "vite build --mode code",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.26.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}
