{
  "name": "math-text-figma-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Figma plugin for mixed Markdown prose and LaTeX mathematics.",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm run build --watch",
    "build": "pnpm run build:ui && pnpm run build:code && pnpm run size:check && pnpm run smoke:controller",
    "build:ui": "vp build --mode ui",
    "build:code": "vp build --mode code",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp lint .",
    "format:check": "vp fmt --check .",
    "format": "vp fmt .",
    "smoke:controller": "node scripts/controller-smoke.mjs",
    "size:check": "node scripts/production-size.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
